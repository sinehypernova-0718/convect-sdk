{
	// Biome is the single source of truth for lint + format.
	"editor.defaultFormatter": "biomejs.biome",
	"editor.formatOnSave": true,
	"editor.codeActionsOnSave": {
		"source.fixAll.biome": "explicit",
		"source.organizeImports.biome": "explicit"
	},

	"[javascript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[typescript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[json]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[jsonc]": {
		"editor.defaultFormatter": "biomejs.biome"
	},

	"biome.lsp.bin": "${workspaceFolder}/node_modules/.bin/biome",
	"biome.enabled": true,

	// TS7 (native/Go-based compiler) — use the workspace-local tsdk,
	// never the bundled VS Code TS version, and disable built-in TS formatting
	// since Biome owns formatting.
	"typescript.tsdk": "node_modules/typescript/lib",
	"typescript.enablePromptUseWorkspaceTsdk": true,
	"typescript.format.enable": false,
	"typescript.preferences.preferTypeOnlyAutoImports": true,
	"typescript.tsserver.maxTsServerMemory": 4096,
	"javascript.format.enable": false,

	// pnpm monorepo (transport → protocol → core → SDK layers)
	"npm.packageManager": "pnpm",
	"eslint.enable": false,

	// Turborepo build/output noise
	"files.watcherExclude": {
		"**/node_modules/**": true,
		"**/dist/**": true,
		"**/.turbo/**": true,
		"**/coverage/**": true
	},
	"search.exclude": {
		"**/node_modules": true,
		"**/dist": true,
		"**/.turbo": true,
		"**/coverage": true,
		"pnpm-lock.yaml": true,
		"**/*.snap": true
	},
	"files.exclude": {
		"**/.turbo": true
	},

	"vitest.vitestPackagePath": "node_modules/vitest/package.json",
	// No root vitest.config.ts — only vitest.workspace.ts + per-package
	// vitest.config.ts under packages/*. Auto-discovery via config glob
	// picks these up; if the extension ever can't find them, add:
	// "vitest.configSearchPatternInclude": "packages/**/vitest.config.ts"

	"cSpell.words": [
		"convect",
		"biomejs",
		"turborepo",
		"pnpm",
		"vitest",
		"turbo",
		"tsdown",
		"rolldown",
		"webserial",
		"mqtt"
	],

	"editor.rulers": [100],
	"files.eol": "\n",
	"files.insertFinalNewline": true,
	"files.trimTrailingWhitespace": true
}
