{
  "name": "@convect/transports",
  "version": "0.1.0",
  "description": "Collection of official transport implementations for Convect",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,

  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",

  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },

  "files": [
    "dist"
  ],

  "engines": {
    "node": ">=24"
  },

  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "pnpm watch",
    "watch": "tsc-watch -p tsconfig.build.json --onCompilationComplete \"tsc-alias -p tsconfig.build.json\"",
    "lint": "eslint src --quiet",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },

  "dependencies": {
    "@convect/core": "workspace:*",
    "@convect/protocol": "workspace:*",

    "@convect/transport-mqtt": "workspace:*"
  },

  "publishConfig": {
    "access": "public"
  }
}
