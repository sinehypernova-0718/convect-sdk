{
	"name": "@convect/transports",
	"version": "0.1.0",
	"description": "Collection of officially supported transport implementations for the Convect SDK.",
	"license": "Apache-2.0",
	"type": "module",
	"sideEffects": false,
	"keywords": [
		"convect",
		"iot",
		"transport",
		"mqtt",
		"serial",
		"webserial",
		"typescript"
	],
	"homepage": "https://github.com/sinehypernova-0718/convect-sdk#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/sinehypernova-0718/convect-sdk.git",
		"directory": "packages/transports"
	},
	"bugs": {
		"url": "https://github.com/sinehypernova-0718/convect-sdk/issues"
	},
	"engines": {
		"node": ">=24"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs",
			"default": "./dist/index.mjs"
		},
		"./mqtt": {
			"types": "./dist/mqtt/index.d.mts",
			"import": "./dist/mqtt/index.mjs",
			"require": "./dist/mqtt/index.cjs",
			"default": "./dist/mqtt/index.mjs"
		},
		"./serial": {
			"types": "./dist/serial/index.d.mts",
			"import": "./dist/serial/index.mjs",
			"require": "./dist/serial/index.cjs",
			"default": "./dist/serial/index.mjs"
		},
		"./webserial": {
			"types": "./dist/webserial/index.d.mts",
			"import": "./dist/webserial/index.mjs",
			"require": "./dist/webserial/index.cjs",
			"default": "./dist/webserial/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"clean": "rimraf dist coverage",
		"format": "biome format .",
		"format:fix": "biome format . --fix",
		"lint": "biome lint .",
		"lint:fix": "biome lint . --fix",
		"prepack": "node ../../scripts/copy-package-meta.mjs ."
	},
	"dependencies": {
		"@convect/core": "workspace:*",
		"@convect/protocol": "workspace:*",
		"@convect/transport-mqtt": "workspace:*",
		"@convect/transport-serial": "workspace:*",
		"@convect/transport-webserial": "workspace:*"
	},
	"publishConfig": {
		"access": "public"
	}
}
