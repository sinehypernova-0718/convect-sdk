{
  "name": "convect-sdk",
  "private": true,
  "version": "0.1.0",
  "description": "An SDK for building reliable communication between IoT devices and applications",
  "license": "Apache-2.0",
  "type": "module",

  "keywords": [
    "iot",
    "iot-platform",
    "mqtt",
    "pnpm",
    "production",
    "sdk",
    "sdk-typescript",
    "typescript"
  ],

  "homepage": "https://github.com/sinehypernova-0718/convect-sdk#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/sinehypernova-0718/convect-sdk.git"
  },

  "bugs": {
    "url": "https://github.com/sinehypernova-0718/convect-sdk/issues"
  },

  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },

  "packageManager": "pnpm@11.0.0",

  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
    "clean": "turbo run clean",

    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },

  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.4",
    "@changesets/cli": "2.31.0",
    "@types/node": "26.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "publint": "0.3.21",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.9.1",
    "tsc-watch": "^7.2.1",
    "tsx": "^4.23.1",
    "turbo": "2.10.7",
    "typescript": "7.0.2",
    "typescript-eslint": "8.65.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "@typescript-eslint/parser>typescript": "npm:@typescript/typescript6@^6.0.3",
      "@typescript-eslint/utils>typescript": "npm:@typescript/typescript6@^6.0.3",
      "@typescript-eslint/typescript-estree>typescript": "npm:@typescript/typescript6@^6.0.3",
      "@typescript-eslint/project-service>typescript": "npm:@typescript/typescript6@^6.0.3",
      "@typescript-eslint/tsconfig-utils>typescript": "npm:@typescript/typescript6@^6.0.3",
      "@typescript-eslint/type-utils>typescript": "npm:@typescript/typescript6@^6.0.3"
    }
  }
}
