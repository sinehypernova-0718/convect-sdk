{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    "**/.env",
    "**/.env.local",
    "**/package.json",
    "**/tsconfig.json",
    "**/biome.json",
    "**/biome.jsonc"
  ],
  "globalEnv": [
    "CI",
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ],
      "cache": true
    },

    "dev": {
      "cache": false,
      "persistent": true
    },

    "lint": {
      "outputs": []
    },
      "outputs": []
    },

    "lint:fix": {
      "cache": false
    },

    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
      "outputs": []
    },

    "test": {
      "dependsOn": [
        "build"
      ],
      "outputs": [
        "coverage/**"
      ]
    },

    "test:watch": {
      "cache": false,
      "persistent": true
    },

    "test:coverage": {
      "dependsOn": [
        "build"
      ],
      "outputs": [
        "coverage/**"
      ]
    },

    "clean": {
      "cache": false
    }
  }
}
