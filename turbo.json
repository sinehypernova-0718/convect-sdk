{
  "$schema": "https://turborepo.com/schema.json",

  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**",
        "tsconfig*.json"
      ],
      "outputs": [
        "dist/**"
      ]
    },

    "dev": {
      "cache": false,
      "persistent": true
    },

    "watch": {
      "cache": false,
      "persistent": true
    },

    "lint": {
      "dependsOn": ["^build"]
    },

    "typecheck": {
      "dependsOn": ["^build"]
    },

    "test": {
      "dependsOn": ["build"]
    },

    "clean": {
      "cache": false
    },

    "format": {
      "cache": false
    },

    "format:check": {},

    "lint:fix": {
      "cache": false
    },

    "test:watch": {
      "cache": false,
      "persistent": true
    }
  }
}
