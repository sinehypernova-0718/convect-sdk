{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",

	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},

	"files": {
		"includes": ["**", "!**/node_modules", "!**/dist", "!**/coverage", "!**/.turbo", "!**/.claude"]
	},

	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100,
		"lineEnding": "lf",
		"attributePosition": "auto"
	},

	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",

			"complexity": {
				"noBannedTypes": "error",
				"noExcessiveCognitiveComplexity": {
					"level": "error",
					"options": {
						"maxAllowedComplexity": 20
					}
				},
				"noExcessiveLinesPerFunction": {
					"level": "warn",
					"options": {
						"maxLines": 75
					}
				},
				"useLiteralKeys": "error",
				"useArrowFunction": "error",
				"useFlatMap": "error",
				"useOptionalChain": "error",
				"useRegexLiterals": "error",
				"useSimplifiedLogicExpression": "error",
				"useNumericLiterals": "error"
			},

			"correctness": {
				"useImportExtensions": {
					"level": "error",
					"options": {
						"forceJsExtensions": true
					}
				},
				"noSwitchDeclarations": "error",
				"useIsNan": "error",
				"useYield": "error"
			},

			"nursery": {
				"useExhaustiveSwitchCases": "error",
				"noFloatingPromises": "error",
				"useNullishCoalescing": "error"
			},

			"suspicious": {
				"useAwait": "error",
				"noArrayIndexKey": "warn",
				"noConsole": "warn",
				"noExplicitAny": "error",
				"useErrorMessage": "error"
			},

			"style": {
				"useAsConstAssertion": "error",
				"useNodejsImportProtocol": "error",
				"useBlockStatements": "error",
				"useConsistentArrayType": "error",
				"useConsistentBuiltinInstantiation": "error",
				"useConsistentMemberAccessibility": "error",
				"useConsistentObjectDefinitions": "error",
				"useConst": "error",
				"useDefaultParameterLast": "error",
				"useExportType": "error",
				"useImportType": "error",
				"useNamingConvention": {
					"level": "error",
					"options": {
						"strictCase": false,
						"conventions": [
							{
								"selector": {
									"kind": "enumMember"
								},
								"formats": ["CONSTANT_CASE"]
							},
							{
								"selector": {
									"kind": "classProperty",
									"modifiers": ["static", "readonly"]
								},
								"formats": ["CONSTANT_CASE"]
							}
						]
					}
				},
				"useNumberNamespace": "error",
				"useReadonlyClassProperties": "warn",
				"useShorthandAssign": "error",
				"useShorthandFunctionType": "error",
				"useTemplate": "error",
				"useThrowOnlyError": "error"
			},

			"performance": {
				"noAccumulatingSpread": "warn",
				"noDelete": "warn"
			},

			"security": {
				"noGlobalEval": "error"
			}
		}
	},

	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},

	"overrides": [
		{
			"includes": ["scripts/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					},
					"complexity": {
						"noExcessiveCognitiveComplexity": "off",
						"noExcessiveLinesPerFunction": "off"
					}
				}
			}
		},
		{
			"includes": [
				"**/*.test.ts",
				"**/*.test.tsx",
				"**/*.spec.ts",
				"**/*.spec.tsx",
				"**/__tests__/**"
			],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					},
					"complexity": {
						"noExcessiveCognitiveComplexity": "off",
						"noExcessiveLinesPerFunction": "off"
					}
				}
			}
		},
		{
			"includes": [
				"**/*.config.js",
				"**/*.config.cjs",
				"**/*.config.mjs",
				"**/*.config.ts",
				"tsdown.config.ts",
				"tsdown.config.base.ts",
				"vitest.config.ts",
				"vitest.workspace.ts"
			],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.d.ts", "**/*.d.mts", "**/*.d.cts"],
			"linter": {
				"enabled": false
			},
			"formatter": {
				"enabled": false
			}
		}
	],

	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"jsxQuoteStyle": "double",
			"quoteProperties": "asNeeded",
			"trailingCommas": "all",
			"semicolons": "always",
			"arrowParentheses": "always",
			"bracketSpacing": true,
			"bracketSameLine": false,
			"attributePosition": "auto"
		},
		"parser": {
			"unsafeParameterDecoratorsEnabled": true
		}
	},

	"json": {
		"formatter": {
			"trailingCommas": "none"
		}
	}
}
